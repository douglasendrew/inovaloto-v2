{
    "name": "inovaloto/backend-tenants",
    "description": "Tenant-specific API for Inovaloto",
    "type": "project",
    "require": {
        "php": "^8.2",
        "nikic/fast-route": "^1.3",
        "illuminate/database": "^11.0",
        "illuminate/events": "^11.0",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
